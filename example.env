# Copie este arquivo para ".env" e ajuste o que precisar.
# Todas as variáveis abaixo já têm um valor padrão no docker-compose.yml
# (${VAR:-padrao}), então mesmo sem preencher, o servidor sobe.

# Versão do Minecraft Java (precisa ser compatível com FORGE_VERSION abaixo)
MC_VERSION=1.20.1

# Tipo de servidor: VANILLA, PAPER, FABRIC, FORGE, etc.
SERVER_TYPE=FORGE

# Versão do Forge (só é usada quando SERVER_TYPE=FORGE)
FORGE_VERSION=47.2.0

# Porta que o servidor vai escutar (padrão Minecraft: 25565)
SERVER_PORT=25565

# Endereço/interface por onde o servidor fica acessível.
# 0.0.0.0 = todas as interfaces de rede.
# Para expor só via Tailscale, coloque aqui o IP do Tailscale do host
# (ex: BIND_IP=100.x.x.x)
BIND_IP=0.0.0.0

# RAM alocada para o servidor Java (ex: 2G, 4G, 6144M)
MEMORY=2G

# Número máximo de jogadores simultâneos
MAX_PLAYERS=10

# Mensagem exibida na lista de servidores do jogo
MOTD=Servidor Minecraft

# Dificuldade: peaceful, easy, normal, hard
DIFFICULTY=normal

# Modo de jogo: survival, creative, adventure, spectator
MODE=survival

# Distância de renderização de chunks enviada aos clientes (em chunks)
VIEW_DISTANCE=10

# true  = só permite contas Mojang/Microsoft legítimas (autenticação online)
# false = permite contas "cracked" (sem autenticação) — cuidado ao expor à internet
ONLINE_MODE=true
